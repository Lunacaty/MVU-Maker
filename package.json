{
  "name": "mvu-maker",
  "version": "0.1.0",
  "description": "为已完成的纯文字角色卡一键增强 MVU 变量、状态栏、角色创建卡片，支持世界书/正则/脚本管理与全流程 LLM 辅助",
  "main": "./out/main/index.js",
  "author": "MVU Maker",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "tsx tests/smoke.test.ts && tsx tests/canvas.test.ts && tsx tests/realparse.test.ts && tsx tests/layout.test.ts && tsx tests/slots.test.ts && tsx tests/copy.test.ts && tsx tests/json.test.ts && tsx tests/initvar.test.ts && tsx tests/png.test.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "jiti": "^2.7.0",
    "lodash": "^4.18.1",
    "monaco-editor": "^0.56.0",
    "openai": "^7.4.0",
    "pinia": "^4.0.2",
    "png-chunks-encode": "^1.0.0",
    "png-chunks-extract": "^1.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  }
}
